# R2 bucket name (Standard storage)
S3_BUCKET_NAME=yuphotos
# Copy the S3 API endpoint from the bucket/account dashboard.
S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
# Bucket-scoped Object Read only credentials. Never commit .env.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional: only scan a directory within the bucket, e.g. photos/
S3_PREFIX=
